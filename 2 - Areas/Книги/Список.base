filters:
  or:
    - file.inFolder("2 - Areas/Книги/В процессе")
    - file.inFolder("2 - Areas/Книги/Готово")
views:
  - type: table
    name: Все
    order:
      - file.name
      - Статус
      - Чтение начато
      - Чтение окончено
      - Готово
    sort:
      - property: Чтение окончено
        direction: DESC
      - property: Готово
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 386
  - type: table
    name: В процессе
    filters:
      or:
        - Статус == "Чтение"
        - Статус == "Анализ"
    order:
      - file.name
      - Статус
      - Чтение начато
      - Чтение окончено
      - Готово
